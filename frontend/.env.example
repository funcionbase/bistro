# Frontend SPA (#220) — configuración de build/runtime.
# Solo variables con prefijo VITE_ quedan expuestas al cliente.

# URL base del backend Laravel para las llamadas a la API (cliente HTTP).
# El SPA y la API se despliegan cross-origin (hosts distintos, mismo site):
#   - PDN:   VITE_API_URL=https://bistro-api.flexyflow.co
#   - QA:    VITE_API_URL=https://panel-api-qa.flexyflow.co (host QA)
#   - Local: dejar VACÍO → las llamadas son relativas y el proxy de Vite
#            (ver vite.config.ts) las redirige a VITE_BACKEND_URL.
# Las cookies (JWT, tdt_*) viajan cross-origin con `credentials: include`;
# el backend habilita CORS con credenciales para estos orígenes.
VITE_API_URL=

# Backend al que el dev server de Vite proxea /api, /auth/google y /storage-proxy.
# Debe coincidir con el puerto de `php artisan serve` (composer dev usa --port=80).
VITE_BACKEND_URL=http://localhost

# Nombre de la aplicación (logo, títulos).
VITE_APP_NAME=flexyflow

# Google Analytics 4 — Measurement ID público. FALLBACK build-time: el valor
# runtime del bootstrap (backend GA4_MEASUREMENT_ID) tiene precedencia. Dejar
# VACÍO en local/qa → GA4 deshabilitado (no carga gtag.js, sin cookies).
VITE_GA4_ID=

# TikTok Pixel — Pixel ID público. Solo carga en la landing pública (`/`).
# Dejar VACÍO en local/qa → pixel deshabilitado (no inyecta events.js).
VITE_TIKTOK_PIXEL_ID=
