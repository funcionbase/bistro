{
    // Config de Cloudflare para servir el SPA como Worker de assets estáticos.
    // El build (`npm run build`) emite a ./dist; este Worker sirve esa carpeta.
    // `not_found_handling: single-page-application` hace que cualquier ruta que
    // no sea un archivo existente devuelva index.html — necesario para que
    // React Router resuelva las rutas del cliente (/dashboard, /t/:qr, etc.).
    //
    // Cutover #239: el subdominio operativo migra a `bistro.flexyflow.co`. Sin
    // soporte dual ni redirect — el host anterior (`restaurante.flexyflow.co`)
    // se apaga al deployar este Worker con el custom domain nuevo. Runbook en
    // `docs/wiki/runbooks/panel-migration.md`.
    "name": "bistro-flexyflow-co",
    "compatibility_date": "2026-05-20",
    // Worker que sirve los assets (binding ASSETS) y reescribe los OG tags solo
    // en /menus/:nit para que la preview de WhatsApp sea del menu del restaurante
    // (worker/index.ts). El resto de rutas pasa a los assets sin tocar.
    "main": "./worker/index.ts",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        // El Worker corre ANTES que el asset-serving SOLO en /menus/* (para poder
        // reescribir los OG). El resto de rutas las sirven los assets directo,
        // sin costo de invocacion del Worker.
        "run_worker_first": ["/menus/*"]
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
        "invocation_logs": true
        },
        "traces": {
        "enabled": true,
        "persist": true,
        "head_sampling_rate": 1
        }
    }
}
