# =============================================================================
# FUENTES DE VALORES POR AMBIENTE
# =============================================================================
# Este archivo es la PLANTILLA + DEFAULTS canonicos. La gran mayoria de
# variables vive solo aqui: el workflow `sync-env-secret.yml` copia este
# archivo literal y luego sobreescribe SOLO un subset corto desde GitHub
# Environments (#174 cleanup). El resultado se guarda en AWS Secrets Manager
# y el UserData de la EC2 lo escribe en
# /var/www/panel.flexyflow/application/.env al boot.
#
# Subset overrideado por GH Environment (qa, pdn):
#   - Por entorno (URLs, hosts, names): APP_NAME, APP_ENV, APP_URL, DB_HOST,
#     DB_DATABASE, DB_USERNAME, AWS_BUCKET, AWS_BUCKET_DOCUMENTS,
#     SESSION_DOMAIN, SESSION_SECURE_COOKIE, GOOGLE_CLIENT_ID,
#     GOOGLE_REDIRECT_URI, MAIL_USERNAME, MAIL_FROM_ADDRESS
#   - Secretos (en pdn como secrets, en qa como vars): APP_KEY, JWT_SECRET,
#     JWT_PAYLOAD_ENCRYPTION_KEY, BOT_JWT_SECRET, CART_JWT_SECRET, DB_PASSWORD,
#     GOOGLE_CLIENT_SECRET, MAIL_PASSWORD
#   - Flags operativos (cambian sin redeploy): LOYALTY_ENABLED, HSTS_ENABLED
#   - Repo-level (compartidos qa+pdn): META_*
#
# Si una variable solo difiere local-vs-cloud pero qa==pdn, NO la metas en
# GH Environment: pon el valor correcto aca y queda. Subir un valor nuevo
# implica commit a este archivo + redeploy.
#
# En EC2, el workflow ademas fuerza APP_ENV=production y APP_DEBUG=false
# como red de seguridad sobre lo que diga el .env.example o GH.
#
# Cualquier credencial sensible en PDN debe ir como Secret (no Variable).
#
# =============================================================================
# APLICACIÓN
# =============================================================================
APP_NAME="restaurante flexyflow"
# Entorno: local | staging | production
APP_ENV=local
# Clave de encriptación de Laravel — generada con: php artisan key:generate
APP_KEY=
# Mostrar stack traces en pantalla (solo local/staging)
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost

# Locale principal de la interfaz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Driver de modo mantenimiento: file | cache
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Número de workers del servidor PHP CLI integrado
PHP_CLI_SERVER_WORKERS=1

# Costo bcrypt para hashing de contraseñas (12 recomendado para producción)
BCRYPT_ROUNDS=12

# =============================================================================
# LOGS
# =============================================================================
# Canal de log: stack | single | daily | slack | papertrail | syslog | errorlog
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Nivel mínimo a registrar: debug | info | notice | warning | error | critical
LOG_LEVEL=debug

# =============================================================================
# BASE DE DATOS
# =============================================================================
# Valores por defecto = stack docker local (docker/docker-compose.yml).
# Para Supabase u otro Postgres remoto, sobreescribir HOST/DB/USERNAME/PASSWORD.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_app
DB_USERNAME=postgres
DB_PASSWORD=root

# =============================================================================
# SESIÓN
# =============================================================================
# Driver: database | file | cookie | redis | memcached | array
SESSION_DRIVER=database
# Tiempo de vida en minutos
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie HttpOnly del JWT (flexyflow_jwt), cookie de mesa (tdt_*) y cookie de
# sesión Laravel.
#   - Producción/staging (HTTPS): SESSION_SECURE_COOKIE=true  → la cookie sólo viaja sobre HTTPS.
#   - Local (http://localhost):    SESSION_SECURE_COOKIE=false → necesario para que el browser la envíe en HTTP.
# OJO cross-origin: el SPA y la API se despliegan en hosts distintos (ver
# FRONTEND_URL). Para que las cookies viajen entre ellos, en PDN/QA hay que
# poner SESSION_SAME_SITE=none, y 'none' EXIGE SESSION_SECURE_COOKIE=true
# (el navegador descarta una cookie 'none' sin 'secure').
SESSION_SECURE_COOKIE=false
# SameSite policy: 'none' es OBLIGATORIO en el deploy cross-origin (PDN/QA)
# — el SPA en bistro.flexyflow.co se autentica contra la API en
# bistro-api.flexyflow.co y las cookies HttpOnly necesitan 'none' para
# viajar entre ambos hosts. Defaultearlo a 'none' acá garantiza que llegue a
# PDN sin depender de un override en GitHub Environment (no está en el subset
# overrideado por sync-env-secret.yml). En local con http://localhost +
# SESSION_SECURE_COOKIE=false la combinación 'none' + 'secure=false' es
# inválida, pero JwtService::buildCookie la degrada automáticamente a 'lax'
# (guard explícito en app/Services/JwtService.php) — local no se rompe.
SESSION_SAME_SITE=none

# =============================================================================
# BROADCASTING / FILESYSTEM / QUEUE
# =============================================================================
BROADCAST_CONNECTION=log
# Disco por defecto. 'local' = filesystem del contenedor; 's3' = MinIO local
# (docker/docker-compose.yml) o S3 real en qa/pdn.
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

# =============================================================================
# CACHÉ
# =============================================================================
# Driver: database | file | redis | memcached | array
CACHE_STORE=database
CACHE_PREFIX=

# =============================================================================
# MEMCACHED
# =============================================================================
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# REDIS
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# CORREO (Amazon SES + Cloudflare Email Routing)
# =============================================================================
# Driver:
#   - local: `log` (escribe el correo a storage/logs/laravel.log, no envia)
#   - qa/pdn: `ses` (Amazon SES via IAM instance profile del ASG, sin keys aqui)
#
# El workflow `.github/workflows/sync-env-secret.yml` overridea MAIL_MAILER=ses
# en qa/pdn. NO subir credenciales SMTP aqui: la autenticidad de SES viene del
# IAM role del EC2 (igual patron que S3, AWS_BUCKET).
#
# Ver `docs/wiki/EMAIL_SES_SETUP.md` para configuracion completa de DKIM,
# Custom MAIL FROM domain, SPF, DMARC, salida de sandbox y Cloudflare Routing.
MAIL_MAILER=ses

# Direccion de origen de TODOS los correos transaccionales del app. Debe
# pertenecer a un dominio verificado en SES (CNAMEs DKIM publicados en CF).
# Convencion: noreply@ para envios automaticos, replies redirigidos a soporte
# via MAIL_REPLY_TO_ADDRESS.
MAIL_FROM_ADDRESS="noreply@flexyflow.co"
MAIL_FROM_NAME="${APP_NAME}"

# Direccion a la que se redirige cualquier respuesta del usuario al correo.
# Buzon recibe via Cloudflare Email Routing → forwarding a Gmail del equipo.
MAIL_REPLY_TO_ADDRESS="soporte@flexyflow.co"

# Buzon interno para alertas operativas (#226): nueva empresa pendiente de
# aprobacion, etc. Default `cristian@flexyflow.co`. En PDN debe quedar en un
# alias que vea el equipo de moderacion.
MAIL_OPS_ALERT_ADDRESS="cristian@flexyflow.co"

# (Opcional) Configuration Set de SES — habilita tracking de bounces/complaints
# via SNS y aplica reglas adicionales (suppression list, dedicated IP pool).
# Se setea en qa/pdn cuando la Fase 2 (#TBD-bounce-handling) este desplegada.
SES_CONFIGURATION_SET=

# (Opcional) Secreto compartido para verificar firma del webhook de SES
# notifications (SNS). Generar con: php -r "echo bin2hex(random_bytes(32));"
# Vive en GitHub Secrets en qa/pdn. Solo aplica con Fase 2 desplegada.
SES_WEBHOOK_SECRET=

# =============================================================================
# AWS S3 (almacenamiento de archivos)
# =============================================================================
# El template es NEUTRAL: no incluye defaults locales que rompan en qa/pdn.
#
# qa/pdn (EC2 con IAM role del instance profile):
#   - AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY se dejan ausentes (el SDK toma
#     credenciales del IMDS del instance profile).
#   - AWS_BUCKET / AWS_BUCKET_DOCUMENTS se definen en GitHub Environment Vars
#     (sync-env-secret.yml las overridea sobre este template).
#   - AWS_ENDPOINT y AWS_URL vacíos → el SDK arma URLs S3 nativas vhost-style.
#
# local (MinIO via docker/docker-compose.yml):
#   - Descomenta el bloque "DEV LOCAL" más abajo en tu .env personal.
#
# Cambios al schema de esta sección deben ir acompañados de revisión del
# .github/workflows/sync-env-secret.yml para que la sincronización a qa/pdn
# siga produciendo un .env coherente.
AWS_DEFAULT_REGION=us-east-1
# Bucket público (assets: logos, imágenes de menú, QR, iconos PWA).
# qa/pdn: definir en GH Env Vars como flexyflow-bistro-{qa|pdn}-assets.
AWS_BUCKET=
# Bucket privado (PDFs de factura, reportes, evidencia de enrolamiento — DIAN 10 años).
# qa/pdn: definir en GH Env Vars como flexyflow-bistro-{qa|pdn}-documents.
AWS_BUCKET_DOCUMENTS=
# Endpoint custom S3-compatible. Vacío = endpoint nativo AWS (qa/pdn).
AWS_ENDPOINT=
# URL base del bucket público. Vacío = vhost-style automático (qa/pdn).
AWS_URL=
# Path-style endpoint addressing. false = vhost-style (AWS S3 real, qa/pdn).
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- DEV LOCAL (MinIO) — descomenta SOLO en tu application/.env personal -----
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_BUCKET=flexyflow-panel-local-assets
# AWS_BUCKET_DOCUMENTS=flexyflow-panel-local-documents
# AWS_ENDPOINT=http://localhost:9000
# AWS_URL=http://localhost:9000/flexyflow-panel-local-assets
# AWS_USE_PATH_STYLE_ENDPOINT=true
# ---------------------------------------------------------------------------

# =============================================================================
# AWS SNS — SMS al cliente por cambios de estado de orden (#275)
# =============================================================================
# Envío de SMS vía Amazon SNS (origen internacional best-effort; Colombia no
# soporta Sender ID, así que el nombre comercial viaja en el cuerpo).
#
# Credenciales: reusa AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY de la sección S3.
# En qa/pdn quedan ausentes → el SDK toma credenciales del IAM instance profile
# (IMDS). El rol de instancia necesita el permiso `sns:Publish` (ver IaC).
#
# Master switch: OFF en local/qa para no gastar saldo SNS (el SMS se registra
# como "skipped"). Se activa en pdn vía GitHub Environment Vars.
SNS_SMS_ENABLED=false
# Región del endpoint SNS. Vacío = reusa AWS_DEFAULT_REGION.
SNS_SMS_REGION=
# Transactional prioriza entrega sobre costo. No cambiar para notificaciones.
SNS_SMS_TYPE=Transactional

# =============================================================================
# SEGURIDAD HTTP
# =============================================================================
# Habilitar headers de seguridad (X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy). Default ON; sin esto la app pierde
# todas las defensas a nivel de respuesta.
SECURITY_HEADERS_ENABLED=true
# Habilitar Content-Security-Policy con nonce por request. Off por default
# porque Tailwind v4 inyecta estilos inline en runtime que requieren nonce
# explicito en style-src; activar solo cuando se cierre P3-1 del #174.
# Rollout plan (#200): primero CSP_ENABLED=true en .env.qa via GH Environment
# vars + 7 días de monitoreo del endpoint /api/v1/csp-report (acción
# 'csp.violation' en audit_logs); si 0 violaciones legitimas → flip en PDN.
CSP_ENABLED=false
# URI donde el browser reporta violaciones CSP. Las violaciones se loguean
# en channel 'single' como warning y se persisten en audit_logs con
# action='csp.violation' para filtrado por dashboards de seguridad.
CSP_REPORT_URI=/api/v1/csp-report
# Habilitar HSTS (Strict-Transport-Security) — requiere TLS valido en el
# dominio + subdominios. Off por default para no romper http://localhost;
# QA/PDN lo activan via GH Environment vars (#174 P3-3).
HSTS_ENABLED=false

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
# Forzar que solo se acepten cuentas de un dominio G Suite específico (ej: empresa.com)
ENFORCE_GSUITE_DOMAIN=false

# =============================================================================
# GOOGLE ANALYTICS 4
# =============================================================================
# Measurement ID (formato G-XXXXXXXXXX). Publico, no secreto. Se expone al
# frontend via GET /api/v1/bootstrap y TIENE PRECEDENCIA sobre el fallback
# build-time VITE_GA4_ID del frontend. En pdn el .env se hidrata desde AWS
# Secrets Manager (NO desde este template): setear ahi si se quiere override
# runtime; si se deja vacio, pdn igual funciona via VITE_GA4_ID. Vacio en
# local/qa => GA4 no carga (sin cookies, sin requests a Google).
GA4_MEASUREMENT_ID=

# =============================================================================
# JWT
# =============================================================================
# Clave secreta para firmar tokens — generada con: php artisan jwt:secret
JWT_SECRET=
# Clave de encriptación del payload
JWT_PAYLOAD_ENCRYPTION_KEY=
# Tiempo de vida del access token / ventana de refresh deslizante en segundos
# (21600 = 6h: ventana de inactividad mínima para cubrir un turno de trabajo)
JWT_TTL=21600
# Tope de vida ABSOLUTO de la sesión en segundos (43200 = 12h). El refresh
# deslizante no puede superarlo; pasado el tope se fuerza re-login. No aplica a KDS.
JWT_MAX_LIFETIME=43200
# Tiempo de vida del refresh token en minutos (20160 = 14 días)
JWT_REFRESH_TTL=20160
# Habilitar blacklist de tokens revocados
JWT_BLACKLIST_ENABLED=true

# =============================================================================
# BOT JWT (chatbots externos — clave separada del JWT de usuario)
# =============================================================================
# Clave secreta HS256 para firmar JWT de bots (consulta GET /api/external/hours/status)
# Generar con: php -r "echo bin2hex(random_bytes(48));"
BOT_JWT_SECRET=
# Tiempo de vida del JWT de bot en segundos
BOT_JWT_TTL=3600

# =============================================================================
# CART JWT (sesión de carrito de pedidos.flexyflow.co — clave separada)
# =============================================================================
# Clave secreta HS256 para firmar el JWT de carrito (CartJwtService)
# Generar con: php -r "echo bin2hex(random_bytes(48));"
CART_JWT_SECRET=
# Tiempo de vida del JWT de carrito en segundos (default: 4200 = 70 min)
CART_JWT_TTL=4200
# URL base donde se sirve el front de carrito (concatena {jwt} al final)
CART_BASE_URL=https://pedidos.flexyflow.co

# =============================================================================
# NEGOCIO — EMPRESA
# =============================================================================
# Estado inicial al crear una empresa: pending_activation | active
DEFAULT_COMPANY_STATUS=pending_activation
# Bancos disponibles para métodos de pago (separados por coma)
AVAILABLE_BANKS=Bancolombia,Davivienda,BBVA,Nequi
# Límite de intentos OAuth por minuto por IP
OAUTH_RATE_LIMIT=10

# =============================================================================
# DOCUMENTOS LEGALES
# =============================================================================
# TOS, privacidad y contrato viven en el wiki externo. URL base por ambiente:
#   dev/local → http://localhost:4321
#   qa/pdn    → https://flexyflow.co
LEGAL_WIKI_BASE_URL=https://flexyflow.co

# =============================================================================
# REPORTES
# =============================================================================
# Rango máximo de fechas permitido al generar un reporte (días)
REPORT_MAX_DATE_RANGE_DAYS=90
# Tiempo de vida del token de descarga de reportes (minutos)
REPORT_DOWNLOAD_TTL=30
# Disco de almacenamiento para reportes exportados: local | s3 | s3_documents
# Reportes contienen datos transaccionales → bucket privado (s3_documents).
REPORT_STORAGE_DISK=s3_documents

# =============================================================================
# CONFIGURACIONES DE EMPRESA (CACHÉ)
# =============================================================================
# TTL en segundos del caché de configuraciones por empresa
COMPANY_SETTINGS_CACHE_TTL=3600
COMPANY_SETTINGS_CACHE_ENABLED=true

# =============================================================================
# MÉTRICAS Y DASHBOARD
# =============================================================================
# TTL en segundos del caché de métricas generales
METRICS_CACHE_TTL=60
# Intervalo de polling del dashboard en segundos
METRICS_POLLING_INTERVAL=30
# Número máximo de platos destacados a mostrar
METRICS_TOP_DISHES_LIMIT=10
# Umbral (%) de tasa de abandono de carrito para activar alerta
DASHBOARD_ABANDONMENT_ALERT_THRESHOLD=15
# Umbral (minutos) de tiempo de entrega para activar alerta
DASHBOARD_DELIVERY_TIME_ALERT_THRESHOLD=45
# Umbral en ms para registrar una query lenta en el log
DB_SLOW_QUERY_THRESHOLD=50

# TTL en segundos de cada sección del dashboard en caché
DASHBOARD_SUMMARY_CACHE_TTL=60
DASHBOARD_CHART_CACHE_TTL=300
DASHBOARD_HEATMAP_CACHE_TTL=600
DASHBOARD_METRICS_CACHE_TTL=300
DASHBOARD_CACHE_ENABLED=true

# =============================================================================
# ROLES Y PERMISOS
# =============================================================================
# Nombres de roles de sistema (sin permisos personalizables)
SYSTEM_ROLES=owner,admin,employee
# Permisos por defecto asignados al rol employee (separados por coma)
DEFAULT_EMPLOYEE_PERMISSIONS=orders.read,chats.read,clients.read,loyalty.read

# =============================================================================
# MENÚ
# =============================================================================
# Disco de almacenamiento de imágenes del menú: s3 | public | local
# Default 's3': QA/PDN apuntan al bucket de assets vía storage-proxy firmado;
# en dev s3 = MinIO en Docker (ver docker/docker-compose.yml). NUNCA usar
# 'local' — Laravel 12 con serve:true en el disco local exige URL firmada y
# devuelve 403 al servir directo desde /storage/.
MENU_IMAGE_DISK=s3
# Tamaño máximo de imagen subida en KB
MENU_IMAGE_MAX_SIZE_KB=2048

# =============================================================================
# COMPRAS A PROVEEDORES
# =============================================================================
# Disco para adjuntos (facturas, notas de entrega, comprobantes de pago).
# En QA/PDN debe ser `s3_documents` (bucket privado, presigned URL, DIAN 10
# años). El default 'local' del config sólo aplica a dev sin docker; en multi
# EC2 (ASG) rompe porque el adjunto queda sólo en una instancia.
PURCHASE_ATTACHMENT_DISK=s3_documents
# Dimensiones del thumbnail generado al subir imagen
MENU_IMAGE_THUMBNAIL_WIDTH=400
MENU_IMAGE_THUMBNAIL_HEIGHT=300
# Límites estructurales del menú
MENU_MAX_CATEGORIES=20
MENU_MAX_ITEMS_PER_CATEGORY=50

# =============================================================================
# CUPONES
# =============================================================================
# Longitud del código de cupón
COUPON_CODE_MIN_LENGTH=4
COUPON_CODE_MAX_LENGTH=20
# Descuento máximo permitido como porcentaje del total
COUPON_MAX_VALUE_PERCENTAGE=80
# Descuento máximo permitido como valor fijo (en moneda local)
COUPON_MAX_FIXED_VALUE=100000
# Validar que el cupón de primer pedido solo aplique a nuevos clientes
COUPON_ENABLE_FIRST_ORDER_VALIDATION=true

# =============================================================================
# FIDELIZACIÓN (#122)
# =============================================================================
# Habilita globalmente el programa. Cada empresa puede overridear con
# company_settings key 'loyalty.enabled'.
LOYALTY_ENABLED=false
# Puntos otorgados por cada peso. 0.001 = 1 pt cada $1.000 COP.
LOYALTY_POINTS_PER_COP=0.001
# Minutos que un cupón de canje vive antes de expirar sin uso.
LOYALTY_REDEMPTION_EXPIRES_MINUTES=30
# Si true: al devolver una orden completada, los puntos otorgados se reversan.
LOYALTY_REFUND_REVERSES_POINTS=true
# Meses de inactividad (sin earn nuevo) tras los cuales el job
# loyalty:expire-stale expira el balance. 0 desactiva.
LOYALTY_EXPIRE_AFTER_MONTHS=12
# Tope absoluto de puntos por ajuste manual (anti-abuso de staff).
LOYALTY_MAX_MANUAL_ADJUST=10000

# =============================================================================
# ENTREGAS
# =============================================================================
# Notificaciones automáticas al cliente sobre su pedido
DELIVERY_NOTIFY_CLIENT_ON_ASSIGNMENT=true
DELIVERY_NOTIFY_CLIENT_ON_COMPLETION=true
# Compartir teléfono del repartidor con el cliente
DELIVERY_SHARE_COURIER_PHONE=true
# Máximo de entregas activas simultáneas por repartidor
DELIVERY_MAX_ACTIVE_PER_COURIER=3

# =============================================================================
# WHATSAPP (notificaciones legacy — pendiente de migrar a Cloud API)
# =============================================================================
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# =============================================================================
# META / WHATSAPP CLOUD API (Tech Provider)
# =============================================================================
# App de Meta de flexyflow (compartida QA + PDN)
META_APP_ID=1265007232388204
# App Secret — SECRETO, nunca commitear. Pegar el valor real en .env local y en GitHub Secrets.
META_APP_SECRET=
# Business Manager de flexyflow
META_BUSINESS_ID=929046296489964
# System User de partner (flexyflow)
META_SYSTEM_USER_ID=61573213870387
# Token "Nunca expira" del System User — SECRETO
META_SYSTEM_USER_TOKEN=
# Embedded Signup configuration ID por ambiente
META_CONFIG_ID_QA=941660645323511
META_CONFIG_ID_PDN=2605276259869097
# Version del Graph API (mantener alineada con la app de Meta)
META_GRAPH_API_VERSION=v25.0
# Verify token del webhook por ambiente (configurar tambien en Meta Developer Console)
META_WEBHOOK_VERIFY_TOKEN_QA=
META_WEBHOOK_VERIFY_TOKEN_PDN=

# =============================================================================
# API
# =============================================================================
# Compresión de respuestas HTTP (gzip)
RESPONSE_COMPRESSION_ENABLED=true
# Paginación por defecto
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100


# =============================================================================
# FACTURACIÓN DE PLATAFORMA
# =============================================================================
# Moneda de facturación (ISO 4217)
BILLING_CURRENCY=COP
# Meses de gracia antes de suspender una cuenta en mora
BILLING_GRACE_MONTHS=2
# Día del mes en que vencen las facturas
BILLING_DUE_DAY=15
# Día del mes en que se generan facturas (mes siguiente)
BILLING_GENERATE_DAY=20
# Hora (UTC) en que corre el cron de generación
BILLING_GENERATE_HOUR=3
# Día del mes en que se marcan facturas como vencidas
BILLING_OVERDUE_DAY=16
# Hora (UTC) en que corre el cron de mora
BILLING_OVERDUE_HOUR=3
# Motor de PDF para facturas (dompdf es el único soportado)
INVOICE_PDF_DRIVER=dompdf
# Disco de almacenamiento para PDFs de facturas: local | s3 | s3_documents
# DIAN exige retención 10 años + acceso restringido → bucket privado (s3_documents).
INVOICE_STORAGE_DISK=s3_documents
# Notificar al owner/admin cuando se genera una nueva factura
BILLING_NOTIFY_ON_GENERATE=true
# Notificar al owner/admin cuando una factura pasa a vencida
BILLING_NOTIFY_ON_OVERDUE=true
# Tiempo de vida (segundos) de la URL firmada para descargar el PDF
BILLING_DOWNLOAD_TTL=3600
# Meses calendario que la empresa puede operar past_due antes de pasar a suspended (#175)
BILLING_PAST_DUE_GRACE_MONTHS=3
# Días de prueba post-creación durante los cuales la empresa se mantiene en active aunque no tenga invoices (#175)
BILLING_TRIAL_DAYS=90
# Disco para comprobantes de pago subidos por el cliente (DIAN: bucket privado) (#175)
BILLING_PAYMENT_PROOF_DISK=s3_documents
# Disco + prefijo para el CSV diario de morosos — uso interno flexyflow (#175)
BILLING_DELINQUENT_EXPORT_DISK=s3_documents
BILLING_DELINQUENT_EXPORT_PREFIX=flexyflow-internal/delinquent-companies
# Email operativo de flexyflow para notificación de comprobantes subidos (#175)
BILLING_OPS_EMAIL=ops@flexyflow.co

# Datos para transferir a flexyflow visibles al cliente (#246 — siempre, no
# solo en mora). Se exponen vía Bootstrap y se renderizan en
# `/company/settings → Facturación` por el componente `FlexyFlowPaymentInfo`.
# En SuspendedBlockedView (#175/#193) siguen apareciendo igual.
#
# Los valores acá son los oficiales: el cliente los verá en su panel, así que
# NO son secretos. sync-env-secret.yml los empaqueta al .env de pdn al correrlo.
# Si necesitás overrides por entorno (ej. cuenta sandbox distinta en qa),
# definilos en GH Settings → Environments → {qa|pdn} → Variables.
FLEXYFLOW_PAYMENT_BREB_KEY="@***REMOVED-BREB-KEY***"
FLEXYFLOW_PAYMENT_BANK_NAME="Bancolombia"
FLEXYFLOW_PAYMENT_ACCOUNT_NUMBER="***REMOVED-ACCOUNT-NUMBER***"
FLEXYFLOW_PAYMENT_ACCOUNT_TYPE="ahorros"
FLEXYFLOW_PAYMENT_ACCOUNT_HOLDER="CRISTIAN MARIN"

# Identificación fiscal de flexyflow (#246) — visible al cliente junto a los
# datos bancarios. NIT/DV se usa para diligenciar la transferencia (algunos
# bancos exigen NIT del destinatario). Defaults reales en config/billing.php.
# IMPORTANTE: TODOS los valores con espacios DEBEN ir entre comillas dobles —
# PHP dotenv rechaza valores con whitespace sin quoting ("Encountered unexpected
# whitespace at [...]").
FLEXYFLOW_NIT="900000001"
FLEXYFLOW_DV="1"
FLEXYFLOW_COMMERCIAL_NAME="flexyflow SAS"
FLEXYFLOW_LEGAL_NAME="flexyflow SAS"
FLEXYFLOW_ADDRESS="Cartago, Valle del Cauca"
FLEXYFLOW_MUNICIPALITY_DANE="76147"
FLEXYFLOW_BILLING_EMAIL="facturacion@flexyflow.co"
FLEXYFLOW_BILLING_PHONE="+***REMOVED-PHONE***"

# =============================================================================
# EXPORTACIÓN PDF
# =============================================================================
# Motor de PDF (dompdf es el único soportado actualmente)
PDF_ENGINE=dompdf
# Tamaño del papel: A4 | letter | legal
PDF_PAPER_SIZE=A4
# Orientación: portrait | landscape
PDF_ORIENTATION=portrait
# Incluir logo de empresa en el encabezado del PDF
PDF_INCLUDE_COMPANY_LOGO=true
# Texto del pie de página en todos los PDFs
PDF_FOOTER_TEXT="Generado por flexyflow"
# Tamaño de fuente base (pt)
PDF_FONT_SIZE=10
# Límite máximo de filas por exportación sincrónica
PDF_MAX_SYNC_ROWS=500

# =============================================================================
# WEB PUSH (PWA) — #149
# =============================================================================
# Claves VAPID (P-256 base64url). Generar con:
#   php artisan push:generate-vapid-keys
# Pegar las dos líneas resultantes y reiniciar Vite (la pública se expone en
# Inertia shared props vía `vapidPublicKey`).
#
# Rotar invalida TODAS las subs existentes — los navegadores re-suscriben
# automáticamente via el listener `pushsubscriptionchange` del SW.
#
# En PDN ambas claves viven en SSM Parameter Store, no en este archivo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Subject de contacto (mailto o URL https). Lo usan los endpoints de FCM/
# Mozilla/Apple para alertar al operador en caso de abuso o entrega bloqueada.
VAPID_SUBJECT=mailto:info@flexyflow.co
# Kill-switch del digest de inventario al login (true|false). Útil para
# desactivar globalmente sin desplegar código.
PUSH_INVENTORY_DIGEST_ENABLED=true

# =============================================================================
# QUEUE / N-INSTANCE SAFETY (CLAUDE.md §12)
# =============================================================================
# Stack canónico: TODO sobre PostgreSQL (no Redis, no SQS). `QUEUE_CONNECTION`
# y `CACHE_STORE` deben ser `database` para que los workers EC2 coordinen
# vía las tablas `jobs` / `failed_jobs` / `cache` / `cache_locks` de postgres.
# NUNCA `sync` (inline, bloquea request) ni `file`/`array` (no comparten
# entre instancias). Para Web Push (#149) los jobs DEBEN encolarse — un
# push síncrono mata el TTFB del endpoint que invoca el dispatch.

# =============================================================================
# FRONTEND
# =============================================================================
# URL del frontend SPA (proyecto independiente). El backend redirige aquí
# tras el callback OAuth y de aquí se derivan los orígenes CORS por default.
#
# NO la definas acá: config/app.php la resuelve por APP_ENV automáticamente:
#   - pdn/production  -> https://bistro.flexyflow.co
#   - qa              -> https://panel-qa.flexyflow.co
#   - local (default) -> http://localhost:5173 (Vite dev server)
# Si se descomenta, FRONTEND_URL gana sobre APP_ENV — úsala SOLO como override
# puntual en local si tu SPA no corre en :5173. En .env.example DEBE quedar
# comentada: el sync copia este archivo literal y un valor de dev se filtraría
# a PDN/QA, rompiendo el redirect post-OAuth (callback mandaría a localhost).
# FRONTEND_URL=http://localhost:5173

# Orígenes permitidos para CORS con credenciales (lista separada por comas).
# Si se deja vacío, config/cors.php deriva la lista de FRONTEND_URL + los
# orígenes locales (http://localhost, :80, :5173). Definí esta variable solo
# si necesitás un set distinto al derivado (p.ej. agregar un dominio extra).
# NUNCA usar '*' — es inválido junto a credenciales y config/cors.php lo
# rechaza por diseño. El patrón de subdominios *.flexyflow.co aplica siempre.
# CORS_ALLOWED_ORIGINS=https://bistro.flexyflow.co
